# ─── App ───────────────────────────────────────────
APP_NAME=konygest
APP_ENV=development          # development | staging | production
DEBUG=true                   # false en staging y production
APP_URL=http://localhost:3000            # URL pública del frontend (enlaces en emails)
CORS_ORIGINS=http://localhost:3000       # separados por comas

# ─── Base de datos ─────────────────────────────────
POSTGRES_USER=konygest
POSTGRES_PASSWORD=           # Generar con: openssl rand -hex 16
POSTGRES_DB=konygest
APP_DB_PASSWORD=             # Contraseña del rol konygest_app (el que usa la API)
# Dueño de las tablas: solo para migraciones
DATABASE_URL=postgresql+psycopg://konygest:CAMBIAR@localhost:5433/konygest
# Rol de la API, sujeto a Row Level Security
DATABASE_APP_URL=postgresql+psycopg://konygest_app:CAMBIAR@localhost:5433/konygest
DATABASE_POOL_SIZE=10

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / JWT ────────────────────────────────────
JWT_SECRET_KEY=              # Generar con: openssl rand -hex 32
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
# Clave Fernet para cifrar secretos guardados (SMTP, claves de IA, 2FA).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Email (valores por defecto si no se configuran en el panel de admin) ──
EMAIL_BACKEND=smtp           # smtp | console
SMTP_HOST=localhost
SMTP_PORT=1025               # Mailpit en desarrollo (bandeja en http://localhost:8025)
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@konygest.local
EMAIL_FROM_NAME=Konygest

# ─── Notificaciones push (Web Push) ────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@klyp.es

# ─── Superadmin inicial (solo lo usa el comando de arranque) ──
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ─── Storage (albaranes y documentos) ──────────────
STORAGE_BACKEND=local        # local (carpeta en disco) | s3 (MinIO o S3 compatible)
STORAGE_LOCAL_PATH=./storage # carpeta del backend local (en Docker: /app/storage)
# Solo con STORAGE_BACKEND=s3. En docker-compose.yml de desarrollo ya se usa el
# servicio minio (consola en http://localhost:9001) con estos valores por defecto.
MINIO_ENDPOINT=localhost:9000            # host:puerto, sin http://
MINIO_ACCESS_KEY=konygest                # usuario de MinIO en desarrollo
MINIO_SECRET_KEY=                        # en desarrollo: konygest-dev-secret; en producción: openssl rand -hex 24
MINIO_BUCKET_NAME=konygest               # se crea al primer uso si no existe
MINIO_SECURE=false                       # true si el endpoint va por HTTPS

# ─── Destinos de documentos de cada empresa (OAuth) ───
# Sin estas credenciales no se ofrecen Google Drive ni OneDrive (SMB y Konygest siempre).
# URI de redirección a registrar: {APP_URL}/api/v1/tenant/storage/oauth/<provider>/callback
# (provider = google_drive | onedrive). Paso a paso en docs/despliegue-coolify.md.
GOOGLE_OAUTH_CLIENT_ID=                  # Google Cloud Console → Credenciales → ID de cliente OAuth
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=               # Microsoft Entra → Registros de aplicaciones → Id. de aplicación
MICROSOFT_OAUTH_CLIENT_SECRET=           # Certificados y secretos → valor del secreto
MICROSOFT_OAUTH_TENANT=common            # common = cuentas de trabajo y personales

# ─── Frontend (Next.js) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Konygest
